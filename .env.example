# Copy to .env.local for local development, and add the same keys in Vercel
# (Project > Settings > Environment Variables). Never commit real values.

# Resend API key (resend.com > API Keys). Sending access is enough.
RESEND_API_KEY=

# Where project briefs are delivered. Fixed on the server; the browser never sets it.
CONTACT_TO=hello@ikonicdesigns.co.za

# Headless WordPress (WPGraphQL), e.g. https://cms.ikonicdesigns.co.za/graphql.
# Leave empty to use the typed local content in src/content.
WORDPRESS_GRAPHQL_URL=

# Optional: "username:application-password" if the GraphQL fields need a login.
WORDPRESS_AUTH=

# Shared secret WordPress sends to /api/revalidate. Any long random string;
# the same value goes in wp-config.php as IKONIC_REVALIDATE_SECRET.
REVALIDATE_SECRET=
